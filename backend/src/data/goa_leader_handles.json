{
  "_meta": {
    "purpose": "Official social-media accounts of Goa leaders and parties. Merged into politicalData.js / politicalEntities.js so the sentiment pipeline recognises a leader both when a post names their handle and when the leader (or party) is the post's AUTHOR (author-is-target correction, cross-camp prior).",
    "researched": "2026-09-25, web research (profile bios, CM/party tags, Wikidata, official sites). X/Instagram pages were read through search-indexed snippets; accounts were not opened directly.",
    "status": "CONFIRMED = official source or two independent sources agree; LIKELY = one decent source (usually the profile's own bio naming the person and office). Fan pages, parody accounts, namesakes and anything weaker than LIKELY are deliberately left out.",
    "keys": "people are keyed by politicalData id; MLAs who are not in the curated lists are keyed 'ac:<roster key from goa_mlas.json>'.",
    "maintenance": "When a handle changes, edit it here with a source URL, then run `npm run test:sentiment`."
  },
